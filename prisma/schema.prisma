// =====================================================================================
//  Ballon TD — Employee Development & Competency Tracking
//  ------------------------------------------------------------------------------------
//  The whole system revolves around two records: EMPLOYEE and COMPETENCY.
//  Everything else is either
//    • REFERENCE data  (set up once, changes rarely: frameworks, competencies, roles,
//                       catalogues, observation parameters, dropdown lists), or
//    • ACTIVITY data   (what people enter: assessments, plans, training, observations,
//                       certifications, coaching, validations, evidence).
//  Calculated values (gap, readiness, averages, completion %) are NEVER stored:
//  the server calculates them and writes them into the Excel export.
//
//  The reference library (frameworks, 160 competencies with 3,245 level indicators, 41 role
//  profiles with 620 requirements, courses, lab collections, certifications, the 25 observed
//  behaviours and the 36 risk rules) is loaded by `npm run db:seed` from server/seed/library/.
//
//  IDs are readable, prefixed strings (EMP-0001, TRN-000123 …) generated by the
//  server from the Counter table. The prefix tells you the table, which makes the
//  one-sheet Activity_Log and any later database import unambiguous.
//
//  Every activity table carries the same audit columns:
//    createdAt, updatedAt, createdBy, updatedBy  — who typed it (the "Entered by" name)
//    source                                      — where it came from (Direct entry,
//                                                  Email from client, Excel from client …)
// =====================================================================================

generator client {
  provider     = "prisma-client"
  output       = "../server/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
}

// -------------------------------------------------------------------------------------
//  SYSTEM
// -------------------------------------------------------------------------------------

/// Next number per ID prefix (EMP → 17 means the next employee is EMP-0018).
model Counter {
  prefix String @id
  value  Int    @default(0)
}

/// One row per create / update / delete, written automatically. Answers "who changed what".
model ChangeLog {
  id         String   @id // LOG-000001
  at         DateTime @default(now())
  user       String?
  action     String // create | update | delete
  entity     String // e.g. TrainingRecord
  recordId   String
  employeeId String?
  summary    String?
  changes    String? // JSON: { field: [old, new] }

  @@index([employeeId])
  @@index([entity, recordId])
}

// -------------------------------------------------------------------------------------
//  REFERENCE DATA — dropdown lists
// -------------------------------------------------------------------------------------

/// Every dropdown in the app (statuses, types, modes …). `list` groups the values.
model LookupValue {
  id          String  @id // LKP-0001
  list        String // e.g. trainingStatus
  value       String
  description String?
  sortOrder   Int     @default(0)
  active      Boolean @default(true)

  @@unique([list, value])
}

// -------------------------------------------------------------------------------------
//  REFERENCE DATA — organisation
// -------------------------------------------------------------------------------------

/// A company we deliver the programme to. Lets one server hold several clients and
/// export one client's data without the others.
model Client {
  id           String    @id // CLI-0001
  name         String    @unique
  industry     String?
  country      String?
  contactName  String?
  contactEmail String?
  notes        String?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  employees    Employee[]
  programs     Program[]
}

/// A programme run for a client (one IDP cycle, e.g. "2026 H2 Leadership & Cyber Pathway").
model Program {
  id          String       @id // PRG-0001
  clientId    String
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  name        String
  cycle       String? // e.g. 2026 H2
  description String?
  startDate   DateTime?
  endDate     DateTime?
  status      String? // lookup: programStatus
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  enrollments Enrollment[]
  sessions    CourseSession[]
}

/// Our own people: consultants, coaches, trainers, assessors. (The client's managers are
/// Employees, not Staff.) `roles` is a "; "-separated list, e.g. "Coach; Trainer".
model Staff {
  id        String   @id // STF-0001
  name      String
  email     String?  @unique
  roles     String? // multi-lookup: staffRole
  phone     String?
  active    Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coachedEnrollments    Enrollment[]          @relation("EnrollmentCoach")
  consultantEnrollments Enrollment[]          @relation("EnrollmentConsultant")
  assessments           Assessment[]
  sessionsTrained       CourseSession[]
  observationDays       ObservationDay[]
  coachingSessions      CoachingSession[]
  evidenceVerified      Evidence[]
}

// -------------------------------------------------------------------------------------
//  REFERENCE DATA — competency framework
// -------------------------------------------------------------------------------------

model Framework {
  id          String               @id // FWK-0001
  code        String               @unique // LEAD, TECH
  name        String
  description String?
  scaleMin    Int                  @default(1)
  scaleMax    Int                  @default(5)
  externalId  String? // key in the source platform (e.g. Lexonis "lexcross")
  categories  CompetencyCategory[]
}

model CompetencyCategory {
  id           String       @id // CAT-0001
  frameworkId  String
  framework    Framework    @relation(fields: [frameworkId], references: [id], onDelete: Restrict)
  code         String       @unique // e.g. COM
  name         String
  sortOrder    Int          @default(0)
  externalId   String? // key in the source platform (e.g. Lexonis "LEX_CF")
  competencies Competency[]
}

model Competency {
  id             String               @id // CMP-0001
  code           String               @unique // e.g. COM-01
  name           String
  categoryId     String
  category       CompetencyCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  description    String?
  supportingText String? // how it is assessed
  minLevel       Int                  @default(1)
  maxLevel       Int                  @default(5)
  active         Boolean              @default(true)
  sortOrder      Int                  @default(0)
  externalId     String? // key in the source platform (Lexonis competency ID)

  behaviors            CompetencyBehavior[]
  requirements         RoleRequirement[]
  courses              CourseCompetency[]
  certifications       CertificationCompetency[]
  observationParams    ObservationParameter[]
  ratings              AssessmentRating[]
  validations          ManagerValidation[]
  idpActions           IdpAction[]
  evidence             Evidence[]
}

/// What a competency looks like at each level (the "behaviour indicators").
model CompetencyBehavior {
  id           String     @id // BHV-0001
  competencyId String
  competency   Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  level        Int
  code         String     @unique // <competency code>-L<level>-<sequence>, e.g. AICI-001-L3-02
  description  String
  externalId   String? // Lexonis behaviour ID (CBPI…), kept to reconcile with the platform
  evidence     Evidence[]

  @@index([competencyId, level])
}

// -------------------------------------------------------------------------------------
//  REFERENCE DATA — job roles and what they require
// -------------------------------------------------------------------------------------

/// A role profile. Required levels live here once, not on every employee row.
/// `nextRoleId` is the usual next step, which gives every person a growth path.
model JobRole {
  id           String            @id // ROL-0001
  code         String            @unique
  name         String
  family       String? // lookup: jobFamily
  seniority    String? // lookup: seniority
  description  String?
  nextRoleId   String?
  nextRole     JobRole?          @relation("CareerPath", fields: [nextRoleId], references: [id], onDelete: SetNull)
  previousRoles JobRole[]        @relation("CareerPath")
  active       Boolean           @default(true)
  requirements RoleRequirement[]
  employees    Employee[]
  assessments  Assessment[]
}

model RoleRequirement {
  id            String     @id // REQ-0001
  jobRoleId     String
  jobRole       JobRole    @relation(fields: [jobRoleId], references: [id], onDelete: Cascade)
  competencyId  String
  competency    Competency @relation(fields: [competencyId], references: [id], onDelete: Restrict)
  requiredLevel Int
  priority      String // lookup: priority (High / Medium / Low)

  @@unique([jobRoleId, competencyId])
}

// -------------------------------------------------------------------------------------
//  REFERENCE DATA — catalogues
// -------------------------------------------------------------------------------------

/// Everything people can attend: instructor-led trainings, workshops, labs, programmes.
/// (The old TRAINING_MASTER and WORKSHOP_MASTER are one table; `type` tells them apart.)
/// `observed` = trainers score behaviours every day (leadership programmes, workshops).
model Course {
  id            String             @id // CRS-0001
  code          String             @unique
  name          String
  type          String // lookup: courseType
  provider      String?
  deliveryMode  String? // lookup: deliveryMode
  durationHours Float?
  days          Int?
  difficulty    String? // lookup: difficulty
  observed      Boolean            @default(false)
  dayTitles     String? // one line per day of an observed programme, e.g. "S1 Team Collaboration"
  labsTotal     Int? // hands-on lab collections: number of labs in the collection
  description   String?
  active        Boolean            @default(true)
  competencies  CourseCompetency[]
  sessions      CourseSession[]
  records       TrainingRecord[]
  idpActions    IdpAction[]
}

/// A course usually builds several competencies.
model CourseCompetency {
  courseId     String
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  competencyId String
  competency   Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@id([courseId, competencyId])
}

model Certification {
  id             String                    @id // CRT-0001
  code           String                    @unique
  name           String
  provider       String?
  track          String? // lookup: certTrack (Professional / AI / Vendor)
  difficulty     String? // lookup: difficulty
  validityMonths Int?
  description    String?
  aliases        String? // other spellings found in client files, one per line (used to match imports)
  active         Boolean                   @default(true)
  competencies   CertificationCompetency[]
  records        CertificationRecord[]
  idpActions     IdpAction[]
}

model CertificationCompetency {
  certificationId String
  certification   Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  competencyId    String
  competency      Competency    @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@id([certificationId, competencyId])
}

/// A behaviour a trainer scores during an observed course (e.g. "Active listening"),
/// and the competency it is evidence for.
model ObservationParameter {
  id           String             @id // OBP-0001
  code         String             @unique
  name         String
  category     String // lookup: observationCategory
  description  String?
  maxScore     Int                @default(5)
  competencyId String?
  competency   Competency?        @relation(fields: [competencyId], references: [id], onDelete: SetNull)
  interpretationLow String? // what a low score means
  actionLow         String? // suggested action when low
  signalHigh        String? // what a consistently high score signals
  sortOrder    Int                @default(0)
  active       Boolean            @default(true)
  scores       ObservationScore[]
}

/// A risk or opportunity rule. The logic for each rule code (R01 … R36) is built into the app
/// (server/lib/risks.ts); the threshold, severity, wording, action and owner are edited here.
model RiskRule {
  id              String   @id // RSK-0001
  code            String   @unique // R01 … R36
  name            String
  panel           String // lookup: riskPanel
  area            String // lookup: riskArea
  appliesTo       String // lookup: riskAppliesTo
  rule            String // the condition in plain language
  threshold       Float?
  thresholdUnit   String?
  severity        String // lookup: riskSeverity (High / Medium / Low / Opportunity)
  executiveAction String?
  owner           String?
  dataSource      String?
  active          Boolean  @default(true)
  sortOrder       Int      @default(0)
}

// =====================================================================================
//  ACTIVITY DATA
// =====================================================================================

/// One row per person in a client company.
model Employee {
  id              String    @id // EMP-0001
  clientId        String
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  employeeNumber  String?
  name            String
  email           String?
  jobTitle        String? // the title as the client writes it
  jobRoleId       String? // the role profile it maps to (drives required levels)
  jobRole         JobRole?  @relation(fields: [jobRoleId], references: [id], onDelete: SetNull)
  grade           String?
  division        String?
  department      String?
  section         String?
  businessUnit    String?
  location        String?
  lineManagerId   String? // the manager, when they are also in the system
  lineManager     Employee? @relation("LineManager", fields: [lineManagerId], references: [id], onDelete: SetNull)
  reports         Employee[] @relation("LineManager")
  lineManagerName String? // used when the manager is not in the system
  status          String? // lookup: employeeStatus
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdBy       String?
  updatedBy       String?
  source          String?

  enrollments        Enrollment[]
  assessments        Assessment[]
  validations        ManagerValidation[]  @relation("ValidationEmployee")
  validationsGiven   ManagerValidation[]  @relation("ValidationManager")
  idpActions         IdpAction[]
  trainingRecords    TrainingRecord[]
  certifications     CertificationRecord[]
  coachingSessions   CoachingSession[]
  evidence           Evidence[]
  baselineSurveys    BaselineSurvey[]

  @@unique([clientId, email])
  @@index([clientId])
}

/// A person taking part in a programme / IDP cycle, with their coach and consultant.
model Enrollment {
  id           String     @id // ENR-0001
  employeeId   String
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  programId    String
  program      Program    @relation(fields: [programId], references: [id], onDelete: Restrict)
  batch        String?
  coachId      String?
  coach        Staff?     @relation("EnrollmentCoach", fields: [coachId], references: [id], onDelete: SetNull)
  consultantId String?
  consultant   Staff?     @relation("EnrollmentConsultant", fields: [consultantId], references: [id], onDelete: SetNull)
  startDate    DateTime?
  endDate      DateTime?
  status       String? // lookup: enrollmentStatus
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  createdBy    String?
  updatedBy    String?
  source       String?

  assessments      Assessment[]
  idpActions       IdpAction[]
  certifications   CertificationRecord[]
  coachingSessions CoachingSession[]
  baselineSurveys  BaselineSurvey[]

  @@unique([employeeId, programId])
}

/// One assessment event (self-assessment, consultant assessment, validation interview,
/// re-assessment …). Each competency score is a row in AssessmentRating.
/// History is kept: a re-assessment is a new Assessment, never an overwrite.
model Assessment {
  id           String             @id // ASM-0001
  employeeId   String
  employee     Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  enrollmentId String?
  enrollment   Enrollment?        @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  type         String // lookup: assessmentType
  date         DateTime?
  assessorId   String?
  assessor     Staff?             @relation(fields: [assessorId], references: [id], onDelete: SetNull)
  jobRoleId    String? // the role profile the person was assessed against
  jobRole      JobRole?           @relation(fields: [jobRoleId], references: [id], onDelete: SetNull)
  status       String? // lookup: assessmentStatus
  reportStatus String? // lookup: reportStatus
  summary      String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  createdBy    String?
  updatedBy    String?
  source       String?
  ratings      AssessmentRating[]
  validations  ManagerValidation[]
}

/// The level given for one competency in one assessment. `requiredLevel` and `priority`
/// are copied from the role profile when the assessment is created (so history stays
/// correct if the role changes later) and can be overridden per person.
/// Gap = requiredLevel − level (calculated, not stored).
model AssessmentRating {
  id            String     @id // RAT-000001
  assessmentId  String
  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  competencyId  String
  competency    Competency @relation(fields: [competencyId], references: [id], onDelete: Restrict)
  level         Int?
  requiredLevel Int?
  priority      String? // lookup: priority
  comment       String?

  @@unique([assessmentId, competencyId])
}

/// A line manager (or the client) confirming a level or an assessment.
model ManagerValidation {
  id                String      @id // VAL-0001
  employeeId        String
  employee          Employee    @relation("ValidationEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  assessmentId      String?
  assessment        Assessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  competencyId      String? // empty = validates the whole assessment
  competency        Competency? @relation(fields: [competencyId], references: [id], onDelete: SetNull)
  managerId         String?
  manager           Employee?   @relation("ValidationManager", fields: [managerId], references: [id], onDelete: SetNull)
  managerName       String? // when the manager is not in the system
  date              DateTime?
  status            String // lookup: validationStatus
  validatedLevel    Int? // level, or 1–5 progress for monthly line-manager validation (round decimals such as 3.2)
  comments          String?
  evidenceReviewed  String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  createdBy         String?
  updatedBy         String?
  source            String?
}

/// Self-reported baseline before an observed programme: experience, six self-ratings on a
/// 1–5 descriptor scale and the MBTI type. Baseline score = average position (1–5) of the six answers.
model BaselineSurvey {
  id                    String      @id // BSL-0001
  employeeId            String
  employee              Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  enrollmentId          String?
  enrollment            Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  date                  DateTime?
  yearsWithOrganisation Float?
  totalYearsExperience  Float?
  confidence            String? // lookup: baselineConfidence
  emotionalRegulation   String? // lookup: baselineEmotionalRegulation
  communication         String? // lookup: baselineCommunication
  accountability        String? // lookup: baselineAccountability
  productivity          String? // lookup: baselineProductivity
  organisation          String? // lookup: baselineOrganisation
  mbti                  String? // lookup: mbti (sensitive: keep out of client-wide reports)
  notes                 String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  createdBy             String?
  updatedBy             String?
  source                String?

  @@index([employeeId])
}

/// The individual development plan: one row per planned action.
/// Training records and certification records can point back to the action they fulfil.
model IdpAction {
  id              String     @id // IDP-0001
  employeeId      String
  employee        Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  enrollmentId    String?
  enrollment      Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  competencyId    String?
  competency      Competency? @relation(fields: [competencyId], references: [id], onDelete: SetNull)
  actionType      String // lookup: idpActionType
  segment         String? // lookup: idpSegment (S1 … S5, DTN)
  title           String
  courseId        String?
  course          Course?    @relation(fields: [courseId], references: [id], onDelete: SetNull)
  certificationId String?
  certification   Certification? @relation(fields: [certificationId], references: [id], onDelete: SetNull)
  owner           String?
  estimatedHours  Float?
  plannedStart    DateTime?
  plannedEnd      DateTime?
  actualStart     DateTime?
  actualEnd       DateTime?
  status          String? // lookup: idpStatus
  progressPct     Int?
  comments        String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  createdBy       String?
  updatedBy       String?
  source          String?

  trainingRecords TrainingRecord[]
  certifications  CertificationRecord[]
}

/// One run of a course: dates, trainer, batch. All participants of the run share it
/// (this is the old "Training Record Code").
model CourseSession {
  id        String    @id // SES-0001
  courseId  String
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Restrict)
  code      String?   @unique // the code used on the client side, if any
  programId String?
  program   Program?  @relation(fields: [programId], references: [id], onDelete: SetNull)
  batch     String?
  startDate DateTime?
  endDate   DateTime?
  trainerId String?
  trainer   Staff?    @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  location  String?
  mode      String? // lookup: deliveryMode
  status    String? // lookup: sessionStatus
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  source    String?
  records   TrainingRecord[]
}

/// One person on one course (in a session, or self-paced without one).
model TrainingRecord {
  id             String     @id // TRN-000001
  employeeId     String
  employee       Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course     @relation(fields: [courseId], references: [id], onDelete: Restrict)
  sessionId      String?
  session        CourseSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  idpActionId    String?
  idpAction      IdpAction? @relation(fields: [idpActionId], references: [id], onDelete: SetNull)
  assignedDate   DateTime?
  startDate      DateTime?
  completionDate DateTime?
  status         String // lookup: trainingStatus
  attendancePct  Float?
  completionPct  Float?
  score          Float?
  hours          Float?
  labsCompleted  Int? // hands-on lab collections: labs completed
  labsTotal      Int? // … out of this many (defaults to the course's labsTotal)
  validatedLevel Int? // observed programmes: level validated before the programme (1–5)
  targetLevel    Int? // observed programmes: target level for the role (1–5)
  comments       String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  createdBy      String?
  updatedBy      String?
  source         String?
  days           ObservationDay[]

  @@unique([employeeId, sessionId])
  @@index([employeeId])
}

/// One person on one day of an observed course: attendance and the trainer's notes.
/// The behaviour scores for that day are rows in ObservationScore.
model ObservationDay {
  id               String           @id // OBS-000001
  trainingRecordId String
  trainingRecord   TrainingRecord   @relation(fields: [trainingRecordId], references: [id], onDelete: Cascade)
  dayNumber        Int
  date             DateTime?
  attendance       String? // lookup: attendance
  observerId       String?
  observer         Staff?           @relation(fields: [observerId], references: [id], onDelete: SetNull)
  potentialNote    String? // lookup: potentialNote
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  createdBy        String?
  updatedBy        String?
  source           String?
  scores           ObservationScore[]

  @@unique([trainingRecordId, dayNumber])
}

model ObservationScore {
  id               String               @id // OSC-000001
  observationDayId String
  observationDay   ObservationDay       @relation(fields: [observationDayId], references: [id], onDelete: Cascade)
  parameterId      String
  parameter        ObservationParameter @relation(fields: [parameterId], references: [id], onDelete: Restrict)
  score            Int?
  comment          String?

  @@unique([observationDayId, parameterId])
}

/// One person working towards one certification.
model CertificationRecord {
  id              String        @id // CER-0001
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  certificationId String
  certification   Certification @relation(fields: [certificationId], references: [id], onDelete: Restrict)
  enrollmentId    String?
  enrollment      Enrollment?   @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  idpActionId     String?
  idpAction       IdpAction?    @relation(fields: [idpActionId], references: [id], onDelete: SetNull)
  assignedDate    DateTime?
  targetDate      DateTime?
  examDate        DateTime?
  completionDate  DateTime?
  expiryDate      DateTime?
  status          String // lookup: certStatus
  score           Float?
  result          String? // lookup: examResult
  credentialId    String?
  certificateUrl  String?
  comments        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  createdBy       String?
  updatedBy       String?
  source          String?
}

model CoachingSession {
  id                String      @id // COA-0001
  employeeId        String
  employee          Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  enrollmentId      String?
  enrollment        Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  coachId           String?
  coach             Staff?      @relation(fields: [coachId], references: [id], onDelete: SetNull)
  date              DateTime
  type              String // lookup: coachingType
  startTime         String? // HH:MM, 1-1 session start
  endTime           String? // HH:MM, 1-1 session end
  prepMinutes       Int? // preparation time
  durationMinutes   Int? // the 1-1 session itself
  reportingMinutes  Int? // writing up afterwards
  // Total coaching effort = prep + session + reporting (calculated)
  status            String? // lookup: coachingStatus
  summary           String?
  challenges        String?
  actionItems       String?
  progressPct       Int?
  // Progress on each segment of the development plan at this session (coaching tracker)
  s1Progress        Int? // S1 professional certification, %
  s1Notes           String?
  s2Progress        Int? // S2 hands-on labs, %
  s2Notes           String?
  s3Progress        Int? // S3 AI certification, %
  s3Notes           String?
  s4Progress        Int? // S4 LMS learning, %
  s4Notes           String?
  s5Progress        Int? // S5 cross-functional training, %
  s5Notes           String?
  dtnProgress       Int? // Department training need, %
  dtnNotes          String?
  otherTrainings    String?
  nextReviewDate    DateTime?
  evidenceSubmitted Boolean?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  createdBy         String?
  updatedBy         String?
  source            String?
}

/// Proof that a competency was shown. `relatedId` can be ANY activity ID
/// (TRN-…, CER-…, COA-…, IDP-…, ASM-…); its prefix says which table it is in.
model Evidence {
  id                 String      @id // EVD-0001
  employeeId         String
  employee           Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  competencyId       String?
  competency         Competency? @relation(fields: [competencyId], references: [id], onDelete: SetNull)
  behaviorId         String? // the behaviour descriptor this evidence is for (coach validation)
  behavior           CompetencyBehavior? @relation(fields: [behaviorId], references: [id], onDelete: SetNull)
  progress           Int? // 1–5 progress scale on that behaviour
  relatedId          String?
  evidenceType       String // lookup: evidenceType
  date               DateTime?
  title              String
  description        String?
  submittedBy        String?
  verifiedById       String?
  verifiedBy         Staff?      @relation(fields: [verifiedById], references: [id], onDelete: SetNull)
  verificationStatus String? // lookup: verificationStatus
  fileLink           String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  createdBy          String?
  updatedBy          String?
  source             String?
}
