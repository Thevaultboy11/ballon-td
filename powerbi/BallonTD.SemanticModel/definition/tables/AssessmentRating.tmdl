	partition AssessmentRating = m
		mode: import
		source =
				let
				    Source = Raw("tbl_AssessmentRating"),
				    Selected = Table.SelectColumns(Source, {"id", "assessmentId", "competencyId", "level", "requiredLevel", "priority", "comment"}, MissingField.UseNull),
				    Typed = Table.TransformColumns(Selected, {{"id", ToText, type nullable text}, {"assessmentId", ToText, type nullable text}, {"competencyId", ToText, type nullable text}, {"level", ToInt, Int64.Type}, {"requiredLevel", ToInt, Int64.Type}, {"priority", ToText, type nullable text}, {"comment", ToText, type nullable text}}),
