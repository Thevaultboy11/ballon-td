				    Renamed = Table.RenameColumns(X1, {{"id", "ID"}, {"type", "Type"}, {"date", "Date"}, {"status", "Status"}, {"reportStatus", "Report"}, {"summary", "Summary / notes"}, {"source", "Source"}, {"createdAt", "Created"}, {"createdBy", "Created by"}, {"updatedAt", "Last changed"}, {"updatedBy", "Changed by"}})
				in
				    Renamed

	annotation PBI_ResultType = Table
