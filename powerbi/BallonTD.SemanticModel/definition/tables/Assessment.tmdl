	partition Assessment = m
		mode: import
		source =
				let
				    Source = Raw("tbl_Assessment"),
				    Selected = Table.SelectColumns(Source, {"id", "employeeId", "type", "date", "status", "jobRoleId", "assessorId", "enrollmentId", "reportStatus", "summary", "source", "createdAt", "createdBy", "updatedAt", "updatedBy"}, MissingField.UseNull),
				    Typed = Table.TransformColumns(Selected, {{"id", ToText, type nullable text}, {"employeeId", ToText, type nullable text}, {"type", ToText, type nullable text}, {"date", ToDate, type nullable date}, {"status", ToText, type nullable text}, {"jobRoleId", ToText, type nullable text}, {"assessorId", ToText, type nullable text}, {"enrollmentId", ToText, type nullable text}, {"reportStatus", ToText, type nullable text}, {"summary", ToText, type nullable text}, {"source", ToText, type nullable text}, {"createdAt", ToDateTime, type nullable datetime}, {"createdBy", ToText, type nullable text}, {"updatedAt", ToDateTime, type nullable datetime}, {"updatedBy", ToText, type nullable text}}),
				    Rows = Table.SelectRows(Typed, each [id] <> null),
				    J0 = Table.NestedJoin(Rows, {"assessorId"}, Table.SelectColumns(Raw("tbl_Staff"), {"id", "name"}, MissingField.UseNull), {"id"}, "_j0", JoinKind.LeftOuter),
				    X0 = Table.ExpandTableColumn(J0, "_j0", {"name"}, {"Assessor"}),
