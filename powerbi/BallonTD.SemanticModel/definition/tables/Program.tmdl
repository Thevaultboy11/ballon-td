	partition Program = m
		mode: import
		source =
				let
				    Source = Raw("tbl_Program"),
				    Selected = Table.SelectColumns(Source, {"id", "clientId", "name", "cycle", "startDate", "endDate", "status", "description", "notes"}, MissingField.UseNull),
				    Typed = Table.TransformColumns(Selected, {{"id", ToText, type nullable text}, {"clientId", ToText, type nullable text}, {"name", ToText, type nullable text}, {"cycle", ToText, type nullable text}, {"startDate", ToDate, type nullable date}, {"endDate", ToDate, type nullable date}, {"status", ToText, type nullable text}, {"description", ToText, type nullable text}, {"notes", ToText, type nullable text}}),
				    Rows = Table.SelectRows(Typed, each [id] <> null),
				    J0 = Table.NestedJoin(Rows, {"clientId"}, Table.SelectColumns(Raw("tbl_Client"), {"id", "name"}, MissingField.UseNull), {"id"}, "_j0", JoinKind.LeftOuter),
				    X0 = Table.ExpandTableColumn(J0, "_j0", {"name"}, {"Client"}),
				    Renamed = Table.RenameColumns(X0, {{"id", "ID"}, {"name", "Name"}, {"cycle", "Cycle"}, {"startDate", "Start"}, {"endDate", "End"}, {"status", "Status"}, {"description", "Description"}, {"notes", "Notes"}})
				in
				    Renamed

	annotation PBI_ResultType = Table
