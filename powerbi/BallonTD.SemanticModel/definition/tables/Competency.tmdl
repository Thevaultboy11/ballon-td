	partition Competency = m
		mode: import
		source =
				let
				    Source = Raw("tbl_Competency"),
				    Selected = Table.SelectColumns(Source, {"id", "code", "name", "categoryId", "minLevel", "maxLevel", "description", "supportingText", "sortOrder", "active"}, MissingField.UseNull),
				    Typed = Table.TransformColumns(Selected, {{"id", ToText, type nullable text}, {"code", ToText, type nullable text}, {"name", ToText, type nullable text}, {"categoryId", ToText, type nullable text}, {"minLevel", ToInt, Int64.Type}, {"maxLevel", ToInt, Int64.Type}, {"description", ToText, type nullable text}, {"supportingText", ToText, type nullable text}, {"sortOrder", ToInt, Int64.Type}, {"active", ToBool, type nullable logical}}),
				    Rows = Table.SelectRows(Typed, each [id] <> null),
				    J0 = Table.NestedJoin(Rows, {"categoryId"}, Table.SelectColumns(Raw("tbl_CompetencyCategory"), {"id", "name"}, MissingField.UseNull), {"id"}, "_j0", JoinKind.LeftOuter),
				    X0 = Table.ExpandTableColumn(J0, "_j0", {"name"}, {"Category"}),
				    J1 = Table.NestedJoin(X0, {"categoryId"}, Table.SelectColumns(Raw("tbl_CompetencyCategory"), {"id", "frameworkId"}, MissingField.UseNull), {"id"}, "_j1", JoinKind.LeftOuter),
				    X1 = Table.ExpandTableColumn(J1, "_j1", {"frameworkId"}, {"frameworkKey"}),
				    F0 = Table.ExpandTableColumn(Table.NestedJoin(X1, {"frameworkKey"}, Table.SelectColumns(Raw("tbl_Framework"), {"id", "name"}, MissingField.UseNull), {"id"}, "_f", JoinKind.LeftOuter), "_f", {"name"}, {"Framework"}),
				    Renamed = Table.RenameColumns(F0, {{"id", "Competency ID"}, {"code", "Code"}, {"name", "Name"}, {"minLevel", "Lowest level"}, {"maxLevel", "Highest level"}, {"description", "Description"}, {"supportingText", "How it is assessed"}, {"sortOrder", "Order"}, {"active", "Active"}})
				in
				    Renamed

	annotation PBI_ResultType = Table
