				    Typed = Table.TransformColumns(Selected, {{"id", ToText, type nullable text}, {"name", ToText, type nullable text}, {"industry", ToText, type nullable text}, {"country", ToText, type nullable text}, {"contactName", ToText, type nullable text}, {"contactEmail", ToText, type nullable text}, {"notes", ToText, type nullable text}, {"active", ToBool, type nullable logical}}),
				    Rows = Table.SelectRows(Typed, each [id] <> null),
