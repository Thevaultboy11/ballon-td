	partition CompetencyBehavior = m
		mode: import
		source =
				let
				    Source = Raw("tbl_CompetencyBehavior"),
				    Selected = Table.SelectColumns(Source, {"id", "competencyId", "level", "code", "description"}, MissingField.UseNull),
				    Typed = Table.TransformColumns(Selected, {{"id", ToText, type nullable text}, {"competencyId", ToText, type nullable text}, {"level", ToInt, Int64.Type}, {"code", ToText, type nullable text}, {"description", ToText, type nullable text}}),
				    Rows = Table.SelectRows(Typed, each [id] <> null),
				    Renamed = Table.RenameColumns(Rows, {{"id", "ID"}, {"level", "Level"}, {"code", "Code"}, {"description", "What it looks like"}})
				in
				    Renamed

	annotation PBI_ResultType = Table
