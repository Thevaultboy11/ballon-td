				    X2 = Table.ExpandTableColumn(J2, "_j2", {"name"}, {"Role profile"}),
				    Renamed = Table.RenameColumns(X2, {{"id", "Employee ID"}, {"name", "Full name"}, {"email", "Email"}, {"employeeNumber", "Employee number"}, {"jobTitle", "Job title"}, {"grade", "Grade"}, {"division", "Division"}, {"department", "Department"}, {"section", "Section / team"}, {"businessUnit", "Business unit"}, {"location", "Location"}, {"lineManagerName", "Line manager (name only)"}, {"status", "Status"}, {"notes", "Notes"}, {"source", "Source"}, {"createdAt", "Created"}, {"createdBy", "Created by"}, {"updatedAt", "Last changed"}, {"updatedBy", "Changed by"}})
