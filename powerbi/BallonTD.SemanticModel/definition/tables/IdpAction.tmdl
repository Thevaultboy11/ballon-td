	partition IdpAction = m
		mode: import
		source =
				let
				    Source = Raw("tbl_IdpAction"),
				    Selected = Table.SelectColumns(Source, {"id", "employeeId", "title", "actionType", "competencyId", "courseId", "certificationId", "enrollmentId", "owner", "estimatedHours", "plannedStart", "plannedEnd", "actualStart", "actualEnd", "status", "progressPct", "comments", "source", "createdAt", "createdBy", "updatedAt", "updatedBy"}, MissingField.UseNull),
				    Typed = Table.TransformColumns(Selected, {{"id", ToText, type nullable text}, {"employeeId", ToText, type nullable text}, {"title", ToText, type nullable text}, {"actionType", ToText, type nullable text}, {"competencyId", ToText, type nullable text}, {"courseId", ToText, type nullable text}, {"certificationId", ToText, type nullable text}, {"enrollmentId", ToText, type nullable text}, {"owner", ToText, type nullable text}, {"estimatedHours", ToNumber, type nullable number}, {"plannedStart", ToDate, type nullable date}, {"plannedEnd", ToDate, type nullable date}, {"actualStart", ToDate, type nullable date}, {"actualEnd", ToDate, type nullable date}, {"status", ToText, type nullable text}, {"progressPct", ToNumber, type nullable number}, {"comments", ToText, type nullable text}, {"source", ToText, type nullable text}, {"createdAt", ToDateTime, type nullable datetime}, {"createdBy", ToText, type nullable text}, {"updatedAt", ToDateTime, type nullable datetime}, {"updatedBy", ToText, type nullable text}}),
				    Rows = Table.SelectRows(Typed, each [id] <> null),
				    A0 = Table.AddColumn(Rows, "Segment", each let t = if [title] = null then "" else [title] in
				            if Text.StartsWith(t, "S1") then "S1 · Professional certification"
				            else if Text.StartsWith(t, "S2") then "S2 · Immersive labs"
				            else if Text.StartsWith(t, "S3") then "S3 · AI certification"
				            else if Text.StartsWith(t, "S4") then "S4 · SAP SuccessFactors"
				            else if Text.StartsWith(t, "S5") then "S5 · Cross-functional training"
				            else if [actionType] = "Department Training Need" then "Department training need"
				            else if [actionType] = "Project Assignment" then "Workplace assignment"
				            else [actionType], type nullable text),
				    Renamed = Table.RenameColumns(A0, {{"id", "ID"}, {"title", "Action"}, {"actionType", "Type"}, {"owner", "Owner"}, {"estimatedHours", "Est. hours"}, {"plannedStart", "Planned start"}, {"plannedEnd", "Planned end"}, {"actualStart", "Actual start"}, {"actualEnd", "Actual end"}, {"status", "Status"}, {"progressPct", "Progress %"}, {"comments", "Comments"}, {"source", "Source"}, {"createdAt", "Created"}, {"createdBy", "Created by"}, {"updatedAt", "Last changed"}, {"updatedBy", "Changed by"}})
				in
				    Renamed

	annotation PBI_ResultType = Table
