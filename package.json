{
  "name": "ballon-td",
  "version": "1.0.0",
  "description": "Internal app for recording every employee development interaction (assessments, plans, training, observations, certifications, coaching, validations, evidence) and exporting it to one structured Excel workbook.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "setup": "npm run db:generate && npm run db:push && npm run db:seed",
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "db:generate": "node scripts/prisma-generate.mjs",
    "db:push": "node scripts/db-push.mjs",
    "db:seed": "tsx server/seed/seed.ts",
    "db:demo": "tsx server/seed/demo.ts",
    "db:reset": "node scripts/db-reset.mjs && npm run db:push && npm run db:seed",
    "db:backup": "node scripts/db-backup.mjs",
    "docs:library": "tsx scripts/library-doc.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "postinstall": "node scripts/prisma-generate.mjs"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "@prisma/driver-adapter-utils": "7.10.1",
    "@prisma/schema-engine-wasm": "8.1.0-1.d1b3f377ca835d73fd50954a5e22128b9ebdd6b8",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^18.0.8",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "prisma": "7.10.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
